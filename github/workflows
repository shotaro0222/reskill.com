name: Auto Generate and Deploy

on:
  # ① 毎日朝8時に自動実行（日本時間はUTC+9なので、UTC23時を指定）
  schedule:
    - cron: '0 23 * * *'
  # ② GitHub画面から手動で実行できるボタンを表示
  workflow_dispatch: 
  # ③ あなたがPCから手動でPushした時も自動デプロイ
  push:
    branches:
      - main

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: write # Gitにコミットするために必要

    steps:
      - name: リポジトリをチェックアウト
        uses: actions/checkout@v4

      - name: Node.jsのセットアップ
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: パッケージのインストール
        run: npm install

      # ---------------------------------------------------
      # 記事の自動生成と保存（スケジュールか手動実行時のみ）
      # ---------------------------------------------------
      - name: Gemini APIで記事を自動生成
        if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
        run: node scripts/generate-article.mjs

      - name: 生成された記事をGitHubにコミットして保存
        if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'
          git add content/posts/
          git diff --quiet && git diff --staged --quiet || git commit -m "Auto-generate new article"
          git push

      # ---------------------------------------------------
      # 静的ファイルのビルドとXserverへの転送
      # ---------------------------------------------------
      - name: Next.jsで静的HTMLをビルド
        run: npm run build

      - name: Xserverへ自動デプロイ (FTP転送)
        uses: SamKirkland/FTP-Deploy-Action@v4.3.4
        with:
          server: ${{ secrets.FTP_HOST }}
          username: ${{ secrets.FTP_USER }}
          password: ${{ secrets.FTP_PASSWORD }}
          # Xserverのドメイン公開フォルダを指定
          server-dir: /re-skill0.com/public_html/
          # Next.jsがビルドしたフォルダを指定
          local-dir: ./out/
